# Base URL da API Backend
# Em desenvolvimento local com o Vite proxy, '/api' redireciona para http://localhost:3000/api
# Em produção, aponte para a URL do backend hospedado, ex: https://sua-api.com/api
VITE_API_BASE_URL=/api

# Base URL da API Simulada (Dummy Data)
VITE_DUMMY_API_URL=https://dummyjson.com

